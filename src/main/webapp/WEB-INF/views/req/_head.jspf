<%@ page pageEncoding="UTF-8"%>
<%--
  요구사항 화면 공통 머리(③ A 요구사항 · ④ B 요구사항이 같이 쓴다).
  다른 점은 색 테마 파일 한 줄(ksis-theme-a.css / ksis-theme-b.css)과 시스템 이름 글자뿐이다.
  KSIS-A 에 적용할 때는 includeCSS.jsp / includeJS.jsp 에 아래 링크 · 스크립트를 넣는다.
--%>
<c:set var="sysCode" value="${theme == 'b' ? 'KSIS-B' : 'KSIS-A'}"/>
<c:set var="sysName" value="영업정보시스템(${sysCode})"/>
<%-- [2번] KSIS-B 는 지금 프로그램처럼 빌드버전을 붙인다(시연은 버전을 몰라 1234-5678). KSIS-A 는 빌드버전 없음 --%>
<c:set var="sysFull" value="Kefico Sales Information System · ${theme == 'b' ? 'Bridge 1234-5678' : 'Advanced'}"/>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${sysCode} 영업정보시스템</title>
<link rel="stylesheet" href="<c:url value='/ksis-ui/css/ksis-theme-${theme}.css'/>">
<link rel="stylesheet" href="<c:url value='/ksis-ui/css/ksis-common.css'/>">
<%-- 탭 검토(/tabs) 전용. 값이 없으면 아무것도 덧붙이지 않아 main(1차 검토본)과 똑같다(탭 1안 · 좌측 메뉴 1안).
     ?tabPlan=2 : 탭 2안(책갈피 탭, 가로바 아래 40px 줄) / ?tabPlan=3 : 2안 탭을 가로바 위로 올린 3안
     ?menuPlan=2~5 : 좌측 메뉴 색 2~5안 --%>
<c:set var="tabPlan" value="${param.tabPlan == '2' || param.tabPlan == '3' ? param.tabPlan : ''}"/>
<c:set var="menuPlan" value="${fn:length(param.menuPlan) == 1 && fn:contains('2345', param.menuPlan) ? param.menuPlan : ''}"/>
<c:if test="${not empty tabPlan || not empty menuPlan}"><script>document.documentElement.setAttribute("data-theme", "${theme}");</script></c:if>
<c:if test="${not empty tabPlan}"><link rel="stylesheet" href="<c:url value='/ksis-ui/css/ksis-tabs-plan2.css'/>">
<script src="<c:url value='/ksis-ui/js/ksis-tabs-plan2.js'/>"></script></c:if>
<c:if test="${tabPlan == '3'}"><link rel="stylesheet" href="<c:url value='/ksis-ui/css/ksis-tabs-plan3.css'/>"></c:if>
<c:if test="${not empty menuPlan}"><link rel="stylesheet" href="<c:url value='/ksis-ui/css/ksis-menu-plans.css'/>">
<link rel="stylesheet" href="<c:url value='/ksis-ui/css/ksis-menu-plan${menuPlan}.css'/>"></c:if>
<link rel="stylesheet" href="<c:url value='/demo/demo-pane.css'/>">
<script src="<c:url value='/ksis-ui/js/ksis-dialog.js'/>"></script>
<script src="<c:url value='/ksis-ui/js/ksis-modal.js'/>"></script>
<script src="<c:url value='/ksis-ui/js/ksis-select.js'/>"></script>
<script src="<c:url value='/ksis-ui/js/ksis-date.js'/>"></script>
<script src="<c:url value='/ksis-ui/js/ksis-file.js'/>"></script>
